   "source": [
    "print('Total donors: ' + str(len(merged_df)))\n",
    "df_regression = merged_df[['TMB_proxy', 'donor_age_at_diagnosis', 'project_code']].dropna()\n",
    "print('Donors with available age at diagnosis: ' + str(len(df_regression)))"
   ]
